target/
*.class
.idea/
*.iml
.vscode/
.DS_Store

# 压测原始逐样本数据（单轮 50~200MB）不入库；
# 汇总(summary-*.txt)与 GC 日志(gc-*.log)是证据，仍入库
loadtest/raw/*.jtl
loadtest/raw/*.jtl.gz
loadtest/raw/proxy-*.log
loadtest/raw/mock-*.log
loadtest/raw/redis.log
loadtest/raw/*-jmeter.log

# 临时进程日志（本地起网关/上游/JMeter 时产生）不入库：
#   /*.log —— 误落在仓库根目录的
#   logs/  —— 统一收拢目录
/*.log
logs/

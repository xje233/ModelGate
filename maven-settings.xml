<?xml version="1.0" encoding="UTF-8"?>
<!--
  ModelGate 专用 Maven 配置。

  为什么需要它：本机全局 settings.xml（Maven 安装目录下 conf/settings.xml）存在两个问题
    1. localRepository 指向 Windows 路径 D:\Software\maven\Repository，在 WSL 下会被当成
       相对路径，把依赖装进项目目录里；
    2. 镜像走 http，Maven 3.9 默认拦截不安全 HTTP 仓库，部分依赖拉不下来。

  用法：
    mvn -s maven-settings.xml clean package
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <localRepository>${user.home}/.m2/repository</localRepository>

  <mirrors>
    <mirror>
      <id>aliyun-https</id>
      <name>Aliyun Central (https)</name>
      <url>https://maven.aliyun.com/repository/central</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
</settings>
